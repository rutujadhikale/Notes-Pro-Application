<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    android:background="@color/my_primary"
    tools:context=".NotesDetailedActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:id="@+id/notes_title_bar_layout">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/add_new_note_tv"
            android:text="Add New Note"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="@color/white"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignRight="@+id/add_new_note_tv"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_alignParentRight="true">

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:paddingRight="10dp"
                android:id="@+id/notes_save_note_btn"
                android:src="@drawable/baseline_check_24"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                />
            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:paddingRight="10dp"
                android:id="@+id/delete_btn"
                android:src="@drawable/baseline_delete_24"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:padding="10dp"
        android:backgroundTint="@color/white"
        android:orientation="vertical"
        android:background="@drawable/edittext_background"
        android:layout_below="@+id/notes_title_bar_layout">

        <EditText
            android:id="@+id/notes_title_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:hint="Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:textColor="@color/black"
            />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/notes_scrollview"
            >
        <EditText
            android:id="@+id/notes_content_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:hint="Write Content here..."
            android:minLines="200"
            android:gravity="top"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="16sp" />
        </ScrollView>



    </LinearLayout>



</RelativeLayout>